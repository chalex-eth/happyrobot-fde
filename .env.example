# LOCAL DEVELOPMENT: base configuration for the API and HappyRobot tools.
# From the repository root: cp -n .env.example .env.local
# npm run dev loads .env.local; npm run local:up also needs .env.docker.local.
# See docs/local-docker.md and docs/happyrobot-agent-runbook.md for setup.
# Fill the ignored copy, never this template. Do not commit real credentials.
#
# Values marked GENERATE belong to this application. Generate each independently:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# This prints one 64-character secret. Paste it into ONE setting; rerun for others.
# Provider credentials must be obtained from the provider, not generated here.

# TMS server hostname/IP supplied by the TMS operator; no http:// prefix.
TMS_HOST=
# TMS TCP port supplied by the operator (integer between 1 and 65535).
TMS_PORT=
# Provider-issued TMS authentication token, sent in the TCP command frame.
TMS_TOKEN=
# GENERATE: required by the optional /api/local/tms diagnostic console.
# This is not the provider's TMS_TOKEN or the MCP token; normal voice/map paths do not use it.
LOCAL_API_TOKEN=
# Obtain an API key for the FMCSA QCMobile service used for carrier authority lookup.
FMCSA_API_KEY=
# Use a HappyRobot API key authorized for Twin SQL in your workspace.
# Can be the same value as HAPPYROBOT_API_KEY; there is no separate Twin-issued key.
# Install the application schema in that workspace first; see docs/architecture.md.
TWIN_API_KEY=

# Required for the demo verification flow. This does not enable real carrier authentication.
OTP_DEMO_MODE=true
# mock displays OTP on screen without sending email/SMS. Keep mock for normal voice calls.
OTP_DELIVERY_MODE=mock
# GENERATE: signs OTP digests and derives the screen code; minimum 32 characters.
# Keep stable across restarts so an active call's displayed code remains valid.
OTP_HASH_SECRET=

# Obtain an API key from your HappyRobot US workspace with workflow/MCP access.
HAPPYROBOT_API_KEY=
# Copy the UUID of your normal carrier-sales workflow from HappyRobot, not a version/run ID.
# A compatible workflow and MCP tool wiring are required; see the agent runbook.
HAPPYROBOT_WORKFLOW_ID=
# The workflow environment the browser calls; the local stack requires development.
HAPPYROBOT_ENVIRONMENT=development

# GENERATE: bearer secret protecting /api/mcp. Use this same value in its saved HappyRobot connection.
MCP_AUTH_TOKEN=
# Public HTTPS URL reachable by HappyRobot: https://YOUR_NGROK_DOMAIN/api/mcp
# It must use NGROK_DOMAIN from .env.docker.local; changing it also requires remote MCP rewiring.
MCP_PUBLIC_URL=
# Choose a unique readable connection name, e.g. Carrier sales development MCP.
# The connector finds/creates a saved HappyRobot connection with this exact name.
HAPPYROBOT_MCP_SERVER_NAME=

# Enable after provider/database setup to let the agent offer and negotiate rates.
NEGOTIATION_ENABLED=false
# Enable with negotiation for the simulated booking step.
BOOKING_ENABLED=false
# mock saves demo bookings without a real TMS reservation; keep mock to reproduce the demo.
BOOKING_TMS_MODE=mock
# Enable the feature-guarded operations behavior after provisioning operator access.
# Dashboard access also requires OPERATOR_RPC_KEY, password and session secret below.
OPERATIONS_ENABLED=false

# GENERATE for a NEW operator setup; reuse the authorized value for an existing workspace.
# This server-only key is distinct from the browser login password.
# After saving it in .env.local, print only its SHA-256 digest with:
# node --env-file=.env.local -e "const k=process.env.OPERATOR_RPC_KEY;if(!k)throw Error('Set OPERATOR_RPC_KEY');console.log(require('node:crypto').createHash('sha256').update(k).digest('hex'))"
# With workspace administrator access, register that digest in Twin SQL:
# INSERT INTO poc_private.operator_access (key_hash) VALUES ('PASTE_SHA256_HEX') ON CONFLICT DO NOTHING;
# The table must already exist. Store the raw key here, NOT the digest; do not reset the database.
OPERATOR_RPC_KEY=
# GENERATE or choose a strong shared demo login password; minimum 12 characters.
OPERATOR_PASSWORD=
# GENERATE separately: signs operator login cookies; minimum 32 characters.
# Changing this invalidates existing logins. Do not reuse the password or OTP secret.
OPERATOR_SESSION_SECRET=
