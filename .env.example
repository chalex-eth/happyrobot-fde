# Server-only settings. Copy into .env.local and fill with challenge credentials.
TMS_HOST=
TMS_PORT=
TMS_TOKEN=
# Separate app access token. Loaded on the server; never entered in the console.
LOCAL_API_TOKEN=
FMCSA_API_KEY=

# Twin REST gateway. Never expose the organization header to the browser.
TWIN_GATEWAY=
TWIN_ORG_ID=
# Explicit demo mapping; every carrier uses this inbox. Not production identity.
OTP_DEMO_MODE=true
# Local demo: the agent requests a code and the authenticated frontend displays it.
OTP_DELIVERY_MODE=mock
DEMO_OTP_EMAIL=
# Generate a random secret of at least 32 characters. Server only.
OTP_HASH_SECRET=
# Published HappyRobot webhook with Enhanced Security enabled.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_API_KEY=

# HappyRobot Web Call startup (server only). Use an explicit workflow/environment.
HAPPYROBOT_API_KEY=
HAPPYROBOT_WORKFLOW_ID=
HAPPYROBOT_ENVIRONMENT=development

# Dedicated server-to-server MCP credential; separate from local diagnostics.
MCP_AUTH_TOKEN=
# Public HTTPS tunnel endpoint, ending in /api/mcp (no secret in URL).
MCP_PUBLIC_URL=

# Optional native adversarial runner, local development only; a DIFFERENT secret.
ADVERSARIAL_MCP_ENABLED=false
ADVERSARIAL_MCP_TOKEN=

# Enable only after docs/twin-m3.5.sql is applied to Twin and the development workflow is ready.
NEGOTIATION_ENABLED=false
