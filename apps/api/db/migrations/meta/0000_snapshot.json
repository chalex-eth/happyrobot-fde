            {
              "expression": "(\"booking\"->>'load_id')",
              "asc": true,
              "isExpression": true,
              "nulls": "last"
            }
          ],
          "isUnique": true,
          "where": "\"poc_calls\".\"booking\"->>'status' in ('pending','confirmed','uncertain') and coalesce(\"poc_calls\".\"booking\"->>'simulated','false') <> 'true'",
