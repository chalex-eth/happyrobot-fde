{
  "name": "@carrier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/server.mjs",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --external:@happyrobot-ai/sdk --external:@modelcontextprotocol/sdk --external:zod --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carrier/contracts": "*",
    "@happyrobot-ai/sdk": "0.1.45",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  }
}
