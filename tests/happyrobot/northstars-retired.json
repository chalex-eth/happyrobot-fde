      "name": "Safe OTP Handling",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Never generate, guess, read back, repeat, or summarize OTP digits, including in the final summary; never ask the caller to click a generate button or type a code."
            }
          ]
        }
