    {
      "id": "01a07bfe-7998-7c07-93df-bd5257546fdf",
      "name": "Prerequisite Recovery Before Resuming",
      "description": [
        {
          "type": "p",
          "children": [
            {
              "text": "After AUTHORITY_REQUIRED or OTP_REQUIRED satisfy the missing prerequisite before protected actions. A carrier change invalidates verification while retaining spent OTP failures. Verification otherwise lasts for the remaining call; never request verification solely because time passed. On OTP_FAILED stop and finalize; do not regenerate or recheck to restore a retry."
            }
          ]
        },
        {
          "type": "p",
          "children": [
            {
              "text": "Distinguish the exact tool error and retry_allowed flag: OTP_INVALID with retry_allowed=true is a recoverable first failure, not OTP_FAILED. Ask for the same screen code again, wait for the caller and verify their next answer. Premature finalization while the caller is continuing is a failure. OTP_FAILED with retry_allowed=false is terminal: stop verification, finalize once, and never regenerate or recheck to reset the budget."
            }
          ]
        }
      ],
      "category": "sequential",
      "category_config": {
        "current_stage": "Protected Actions Resumed",
        "prerequisite_stage": "Required Prerequisite Recompleted"
      },
      "enabled": true,
      "priority": "medium",
      "positive_examples": [
        {
          "type": "p",
          "children": [
            {
              "text": "verify_otp returns OTP_INVALID, failures_remaining=1, retry_allowed=true. The agent asks for the same screen digits, waits, then verifies the new caller answer successfully."
            }
          ]
        },
        {
          "type": "p",
          "children": [
            {
              "text": "The second wrong answer returns OTP_FAILED, failures_remaining=0, retry_allowed=false. The agent truthfully explains failure and finalizes without further verification."
            }
          ]
        }
      ],
      "negative_examples": [
        {
          "type": "p",
          "children": [
            {
              "text": "The first wrong answer returns OTP_INVALID and retry_allowed=true, but the agent claims the attempt limit is exhausted and finalizes while the caller wants to retry."
            }
          ]
        },
        {
          "type": "p",
          "children": [
            {
              "text": "OTP_FAILED and retry_allowed=false are returned, but the agent retries verification, regenerates a code, or rechecks the carrier to gain another attempt."
            }
          ]
        }
      ],
      "node_ids": [
        "f624a1ccbd8fdd27"
      ],
