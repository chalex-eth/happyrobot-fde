      "id": "01a07bfe-7998-7078-b1d7-0bf946fbfbb1",
      "name": "negotiate_offer Tool Invocation",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "For every acceptance, rejection, or counter, call negotiate_offer with the latest exact load_id and offer_id. Omit amount for accept or reject; use only the clarified total USD amount for counters, with at most three distinct counter rounds per call."
            }
          ]
        }
