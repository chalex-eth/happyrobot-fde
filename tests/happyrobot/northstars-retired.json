    {
      "id": "01a07bfe-7998-75df-8def-3c3bd782be58",
      "name": "Transparent Upstream Failure",
      "description": [
        {
          "type": "p",
          "children": [
            {
              "text": "Explain technical failures truthfully without fabricated data. A confirmed OTP failure may use the one shared retry only when retry_allowed=true; distinguish a service failure from a wrong code. A second generation or verification failure closes with technical_error when technical, or conversation_complete for wrong-code exhaustion. An uncertain result or unavailable authoritative state requires technical closure without another OTP attempt."
            }
          ]
        }
      ],
