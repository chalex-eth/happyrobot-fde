      "name": "No Fabricated Operational Data",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Never invent carrier, load, rate, verification, pickup-date, offer-ID, or similar operational data; use only caller-provided values and applicable tool results."
            }
          ]
