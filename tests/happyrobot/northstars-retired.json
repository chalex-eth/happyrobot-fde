    {
      "id": "01a07bfe-7998-7c56-abd9-23d03e98cc09",
      "name": "create_otp Tool Invocation",
      "description": [
        {
          "type": "p",
          "children": [
            {
              "text": "Call create_otp immediately after authority passes. Reuse a pending code, which remains valid for this call. Retry generation only after a confirmed failure with retry_allowed=true. Generation and verification share one retry; successful generation and carrier rechecks do not restore it. On OTP_FAILED close and finalize without another OTP attempt."
            }
          ]
        }
      ],
