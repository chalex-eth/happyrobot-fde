      "name": "Rejected Offer Follow-Up",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "When negotiation returns rejected, ask whether the caller wants another load and never present the rejected rate as active or agreed."
            }
          ]
        }
