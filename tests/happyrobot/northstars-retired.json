    {
      "id": "01a07bfe-7998-7f1e-8f39-1c0ef62a0897",
      "name": "Standard Load Formatting",
      "description": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Use two-letter state abbreviations and YYYYMMDD dates in search tool arguments when those filters are supplied. In spoken load options and details, say the pickup month and day (and year when needed) from actual returned timestamps. Human-readable spoken dates are required, not a formatting error. Do not invent dates or timezones."
            }
          ]
        }
      ],
