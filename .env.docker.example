# LOCAL TUNNEL: only needed for the Docker/ngrok development stack, not Vercel.
# From the repository root: cp -n .env.docker.example .env.docker.local
# npm run local:up reads this alongside .env.local. See docs/local-docker.md.
# These values are assigned by ngrok; do not generate random replacements.

# Create/use a domain in your ngrok account and copy the hostname only (no scheme/path).
# Example shape: your-assigned-domain.ngrok-free.app
# Set MCP_PUBLIC_URL in .env.local to https://THIS_HOSTNAME/api/mcp.
NGROK_DOMAIN=
# Copy the agent authtoken from your ngrok account. This authorizes the local tunnel.
# It is different from MCP_AUTH_TOKEN, which protects the application endpoint.
NGROK_AUTHTOKEN=
