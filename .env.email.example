# OPTIONAL EMAIL ADAPTER PROFILE: for deliberately testing email OTP delivery.
# From the repository root: cp -n .env.email.example .env.email.local
# Load AFTER .env.local in a separate local API process, for example:
# node --env-file=.env.local --env-file=.env.email.local --import tsx apps/api/src/server.ts
# Stop any API already using the same port before running this command.
# Keep OTP_DEMO_MODE=true and OTP_HASH_SECRET configured in the base file.
# This profile does not rewire the normal voice agent: its MCP create_otp uses screen OTP.
# The local OTP adapter's send action supports email. Normal Docker startup requires
# mock delivery, and hosted demo configuration rejects email mode.

# Selects the email adapter for the supported local OTP send path.
OTP_DELIVERY_MODE=email
# Your controlled test inbox. All demo emails go here, not to arbitrary caller addresses.
DEMO_OTP_EMAIL=
# Supply an HTTPS webhook YOU host, or a compatible automation that sends the email.
# This repository does not deploy an email service. The endpoint must accept JSON:
# {to, code, call_id, challenge_id, mc_number, demo:true}, with x-api-key authentication.
# Send the email and return a 2xx response within 8 seconds; do not log OTP codes.
OTP_WEBHOOK_URL=
# Use the API key expected by that webhook (not automatically your email vendor's key).
# If you own the webhook, generate a shared secret and configure both sides identically:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_WEBHOOK_API_KEY=
