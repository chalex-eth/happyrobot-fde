# HOSTED DEMO: independent production configuration for a Vercel deployment.
# From the repository root: cp -n .env.production.example .env.production.local
# Fill the ignored copy for release scripts, then add the application values to
# Vercel Project Settings -> Environment Variables -> Production and redeploy.
# A local file alone does not configure Vercel. See docs/production.md.
# Do not load Docker, evaluation or email overlays into this hosted demo.
#
# For each setting marked GENERATE, run this command separately:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the 64-character result into ONE setting. Generate independent production
# secrets instead of copying local ones, except when deliberately sharing an existing operator key.
# Obtain provider credentials from your own service accounts. Never commit real values.

# Runtime mode for local release scripts. Vercel already supplies production NODE_ENV.
NODE_ENV=production
# Enables the authenticated hosted demo routes; requires mock OTP and mock booking.
HOSTED_DEMO_ENABLED=true
# Replace with your stable HTTPS origin, without a trailing slash or path.
APP_PUBLIC_URL=https://your-project.vercel.app

# TMS hostname/IP from the service operator; the API connects directly over TCP.
TMS_HOST=
# Provider's TCP port, an integer between 1 and 65535.
TMS_PORT=
# Provider-issued token authenticating the TMS commands; not an app-generated token.
TMS_TOKEN=
# API key issued for FMCSA QCMobile carrier authority lookups.
FMCSA_API_KEY=
# HappyRobot API key authorized for Twin SQL in your chosen workspace.
# May equal HAPPYROBOT_API_KEY. Provision the app schema before deployment.
TWIN_API_KEY=

# Keep true: this deployment uses demo verification.
OTP_DEMO_MODE=true
# Keep mock: OTP is shown on screen, with no email/SMS delivery.
OTP_DELIVERY_MODE=mock
# GENERATE: minimum 32 characters; signs OTP data and derives screen codes.
# Keep stable across instances and redeployments while calls are active.
OTP_HASH_SECRET=

# API key from your HappyRobot US workspace with workflow/MCP access.
HAPPYROBOT_API_KEY=
# UUID of your normal carrier-sales workflow; not a version/run ID.
# Publish a compatible version in production and wire its MCP tools; see the agent runbook.
HAPPYROBOT_WORKFLOW_ID=
# Selects the production workflow when the browser starts a call.
HAPPYROBOT_ENVIRONMENT=production

# GENERATE: bearer secret for /api/mcp. Set the identical token in HappyRobot's saved MCP connection.
# Rotating this requires updating both Vercel and that saved connection.
MCP_AUTH_TOKEN=
# Use APP_PUBLIC_URL followed by /api/mcp. HappyRobot must reach this HTTPS URL.
MCP_PUBLIC_URL=https://your-project.vercel.app/api/mcp
# Choose a unique saved connection name containing production; the connector requires that label.
HAPPYROBOT_MCP_SERVER_NAME=Carrier sales production MCP

# Enables rate offers and negotiation.
NEGOTIATION_ENABLED=true
# Enables the booking flow; BOOKING_TMS_MODE below keeps it simulated.
BOOKING_ENABLED=true
# Required for hosted demo: no real TMS reservation is created.
BOOKING_TMS_MODE=mock
# Enables feature-guarded operations behavior; provision operator access below.
OPERATIONS_ENABLED=true

# GENERATE for a NEW operator setup, or reuse the key already authorized in this Twin workspace.
# This is a server-side database authorization key, not the browser login password.
# After saving it in .env.production.local, print its SHA-256 digest with:
# node --env-file=.env.production.local -e "const k=process.env.OPERATOR_RPC_KEY;if(!k)throw Error('Set OPERATOR_RPC_KEY');console.log(require('node:crypto').createHash('sha256').update(k).digest('hex'))"
# With workspace administrator access, register the digest after schema installation:
# INSERT INTO poc_private.operator_access (key_hash) VALUES ('PASTE_SHA256_HEX') ON CONFLICT DO NOTHING;
# Put the raw key here and in Vercel, NOT the digest. Do not reset an existing database.
OPERATOR_RPC_KEY=
# GENERATE or choose a strong shared demo login password; minimum 12 characters.
OPERATOR_PASSWORD=
# GENERATE independently: signs login cookies; minimum 32 characters.
# Must match across instances; changing it invalidates existing logins.
OPERATOR_SESSION_SECRET=

# Keep false: hosted demo configuration rejects enabled adversarial tooling.
ADVERSARIAL_MCP_ENABLED=false
