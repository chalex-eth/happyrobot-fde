# OPTIONAL EVALUATION OVERLAY: isolated adversarial and negotiation tests.
# From the repository root: cp -n .env.eval.example .env.eval.local
# The test:adversarial and test:negotiation npm commands load this AFTER .env.local.
# The API under test must also enable the isolated route and use the same token.
# The normal Docker stack deliberately disables/does not expose that route.
# Use the isolated setup in docs/happyrobot-agent-runbook.md; this file alone is not enough.
# Never load this overlay into the normal hosted demo or publish an evaluation draft.

# Enables the /api/mcp/adversarial test route in the configured test process.
ADVERSARIAL_MCP_ENABLED=true
# GENERATE a separate test bearer secret; do not reuse normal MCP_AUTH_TOKEN:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put the same value in the test API, controller environment and saved adversarial MCP connection.
ADVERSARIAL_MCP_TOKEN=
